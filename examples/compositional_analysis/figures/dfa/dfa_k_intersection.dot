digraph k_intersection {
  rankdir=LR;
  bgcolor="white";
  node [fontname="Helvetica"];
  edge [fontname="Helvetica"];
  start [shape=plaintext, label="start", fontcolor="#777777"];
  ok [label="ok", shape=circle, style="filled", fillcolor="#d8efe1", color="#1f7a4d", fontcolor="#1f7a4d", fontname="Helvetica", peripheries=2, width=1.0, fixedsize=true];
  in_turn_1 [label="in_turn_1", shape=circle, style="filled", fillcolor="#e1e1f5", color="#4a3fb0", fontcolor="#4a3fb0", fontname="Helvetica", peripheries=2, width=1.0, fixedsize=true];
  in_turn_2 [label="in_turn_2", shape=circle, style="filled", fillcolor="#e1e1f5", color="#4a3fb0", fontcolor="#4a3fb0", fontname="Helvetica", peripheries=2, width=1.0, fixedsize=true];
  dots [label="...", shape=plaintext, fontsize=18, fontcolor="#555555"];
  in_turn_K [label="in_turn_K", shape=circle, style="filled", fillcolor="#e1e1f5", color="#4a3fb0", fontcolor="#4a3fb0", fontname="Helvetica", peripheries=2, width=1.0, fixedsize=true];
  completed [label="completed", shape=circle, style="filled", fillcolor="#d8efe1", color="#1f7a4d", fontcolor="#1f7a4d", fontname="Helvetica", peripheries=2, width=1.0, fixedsize=true];
  violated [label="violated", shape=circle, style="filled", fillcolor="#f7e1dc", color="#b13c2a", fontcolor="#b13c2a", fontname="Helvetica", peripheries=1, width=1.0, fixedsize=true];
  start -> ok [label="", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  ok -> ok [label="pre_turn", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  ok -> completed [label="turn_done", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  ok -> in_turn_1 [label="in_turning", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_1 -> in_turn_2 [label="in_turning", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_1 -> completed [label="turn_done", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_1 -> violated [label="pre_turn", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_2 -> dots [label="in_turning", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_2 -> completed [label="turn_done", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_2 -> violated [label="pre_turn", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  dots -> in_turn_K [label="in_turning", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_K -> violated [label="in_turning", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_K -> completed [label="turn_done", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  in_turn_K -> violated [label="pre_turn", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  completed -> completed [label="any (absorbing)", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
  violated -> violated [label="any (absorbing)", color="#555555", fontcolor="#555555", fontname="Helvetica", fontsize=11];
}
